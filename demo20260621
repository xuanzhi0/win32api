/**
 * @brief 應用程式進入點（Unicode 版本）。
 *
 * @param hInstance 應用程式實例句柄。
 * @param hPrevInstance 過去的實例（未使用）。
 * @param intCmdShow 指定視窗顯示方式（傳遞給 Create 的 nCmdShow）。
 * @param nShowCmd 未使用（保留）。
 * @return int 程序結束代碼。
 */
int WINAPI wWinMain(HINSTANCE hInstance, HINSTANCE hPrevInstance, PWSTR intCmdShow, int nShowCmd) {
    PokerWindowApp app(hInstance);
    if (!app.Create(nShowCmd)) return 0;
    return app.Run();
}
