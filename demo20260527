#include <windows.h>
#include <tchar.h>

#define ID_SINGLE  1001
#define ID_DOUBLE 1002
#define ID_MUTIPLE 1003
#define ID_HELP_ABOUT 1004

LRESULT CALLBACK WndProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam) {
    switch (msg) {
    case WM_COMMAND:
        switch (LOWORD(wParam)) {
        case ID_SINGLE:
            break;
        case  ID_DOUBLE:
            break;
        case ID_MUTIPLE:
            break;
        case ID_HELP_ABOUT:
            MessageBox(hwnd, _T("Group 17."), _T("About"), MB_OK | MB_ICONINFORMATION);
            break;
        }
        break;

    case WM_PAINT: {
        PAINTSTRUCT ps;
        HDC hdc = BeginPaint(hwnd, &ps);
        
        // 必須開啟進階圖形模式，SetWorldTransform 才能生效
        SetGraphicsMode(hdc, GM_ADVANCED);

        // 字型設定 (加入 J, Q, K 用的大字型)
        HFONT hFont = CreateFont(32, 0, 0, 0, FW_BOLD, FALSE, FALSE, FALSE, DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS, DEFAULT_QUALITY, DEFAULT_PITCH | FF_SWISS, L"Segoe UI Symbol");
        HFONT hSmall = CreateFont(16, 0, 0, 0, FW_BOLD, FALSE, FALSE, FALSE, DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS, DEFAULT_QUALITY, DEFAULT_PITCH | FF_SWISS, L"Segoe UI Symbol");
        HFONT hBigFont = CreateFont(72, 0, 0, 0, FW_BOLD, FALSE, FALSE, FALSE, DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS, DEFAULT_QUALITY, DEFAULT_PITCH | FF_SWISS, L"Segoe UI Symbol");

        // 設定文字背景透明
        SetBkMode(hdc, TRANSPARENT);
        
        // 準備白底黑框的畫筆與筆刷
        SelectObject(hdc, GetStockObject(WHITE_BRUSH));
        SelectObject(hdc, GetStockObject(BLACK_PEN));

        // 卡片網格與縮放設定 (配合圖片：每排 14 張)
        int cols = 14;
        float scale = 0.35f; 
        float cardW = 220.0f;
        float cardH = 300.0f;
        float padding = 8.0f;

        const wchar_t* valStrs[] = { L"A", L"2", L"3", L"4", L"5", L"6", L"7", L"8", L"9", L"10", L"J", L"Q", L"K" };
        const wchar_t* suits[] = { L"♠", L"♥", L"♦", L"♣" };

        // 180度旋轉矩陣 (以卡片中心 110, 150 為基準點翻轉整張卡)
        XFORM rot180 = { -1.0f, 0.0f, 0.0f, -1.0f, 220.0f, 300.0f };

        // 畫出 52 張牌
        for (int i = 0; i < 52; ++i) {
            int col = i % cols;
            int row = i / cols;
            int suitIdx = i / 13;
            int valIdx = i % 13;

            // 計算此卡片在視窗上的左上角位置
            float x = 10.0f + col * (cardW * scale + padding);
            float y = 10.0f + row * (cardH * scale + padding);

            // 儲存原始畫布 Transform 狀態
            XFORM xfBase;
            GetWorldTransform(hdc, &xfBase);

            // 套用此卡片的平移與縮放矩陣
            XFORM xfCard;
            xfCard.eM11 = scale; xfCard.eM12 = 0;
            xfCard.eM21 = 0; xfCard.eM22 = scale;
            xfCard.eDx = x;
            xfCard.eDy = y;
            ModifyWorldTransform(hdc, &xfCard, MWT_LEFTMULTIPLY);

            // 1. 畫出卡片白色外框 (基於本地座標 0~220, 0~300)
            Rectangle(hdc, 0, 0, (int)cardW, (int)cardH);

            // 2. 判斷並設定花色顏色 (紅心、方塊為紅色)
            if (suitIdx == 1 || suitIdx == 2) {
                SetTextColor(hdc, RGB(255, 0, 0)); 
            } else {
                SetTextColor(hdc, RGB(0, 0, 0));   
            }

            const wchar_t* val = valStrs[valIdx];
            const wchar_t* suit = suits[suitIdx];

            // --- 3. 畫左上角數字與小花色 ---
            SelectObject(hdc, hFont);
            TextOut(hdc, 15, 10, val, wcslen(val));
            SelectObject(hdc, hSmall);
            TextOut(hdc, 15, 45, suit, wcslen(suit));

            // --- 4. 畫右下角數字與小花色 (利用旋轉180度) ---
            XFORM xfOrigCard;
            GetWorldTransform(hdc, &xfOrigCard); // 記下當前卡片的矩陣
            ModifyWorldTransform(hdc, &rot180, MWT_LEFTMULTIPLY); // 翻轉畫布

            SelectObject(hdc, hFont);
            TextOut(hdc, 15, 10, val, wcslen(val)); // 用跟左上角一模一樣的座標去畫
            SelectObject(hdc, hSmall);
            TextOut(hdc, 15, 45, suit, wcslen(suit));

            SetWorldTransform(hdc, &xfOrigCard); // 轉回來

            // --- 5. 畫卡片中央的大花色陣型 ---
            SelectObject(hdc, hFont);
            int cx = 100, dx = 40;

            // 定義一個 Lambda 函數，幫助我們繪製上下對稱的花色
            auto DrawHalf = [&](bool isReversed) {
                if (isReversed) ModifyWorldTransform(hdc, &rot180, MWT_LEFTMULTIPLY);

                if (valIdx == 1 || valIdx == 2) { TextOut(hdc, cx, 40, suit, wcslen(suit)); } // 2, 3
                if (valIdx >= 3 && valIdx <= 9) { // 4 ~ 10 皆有左上與右上
                    TextOut(hdc, cx - dx, 40, suit, wcslen(suit));
                    TextOut(hdc, cx + dx, 40, suit, wcslen(suit));
                }
                // 8, 10 上下皆有中間點。7 只有正向有中間點。
                if (valIdx == 7 || valIdx == 9 || (valIdx == 6 && !isReversed)) { 
                    TextOut(hdc, cx, 75, suit, wcslen(suit));
                }
                if (valIdx == 8 || valIdx == 9) { // 9, 10 (中上段兩側)
                    TextOut(hdc, cx - dx, 100, suit, wcslen(suit));
                    TextOut(hdc, cx + dx, 100, suit, wcslen(suit));
                }

                if (isReversed) SetWorldTransform(hdc, &xfOrigCard);
            };

            DrawHalf(false); // 畫上半部陣型 (正向)
            DrawHalf(true);  // 畫下半部陣型 (自動旋轉成倒立)

            // --- 6. 畫正中央獨立的花色 (不需對稱翻轉) ---
            if (valIdx == 0 || valIdx == 2 || valIdx == 4 || valIdx == 8) { // A, 3, 5, 9
                TextOut(hdc, cx, 130, suit, wcslen(suit));
            }
            if (valIdx == 5 || valIdx == 6 || valIdx == 7) { // 6, 7, 8 中央兩側
                TextOut(hdc, cx - dx, 130, suit, wcslen(suit));
                TextOut(hdc, cx + dx, 130, suit, wcslen(suit));
            }

            // --- 7. 針對 J, Q, K 畫正中央大字 ---
            if (valIdx >= 10) {
                SelectObject(hdc, hBigFont);
                // 微調 X 座標使大字置中
                TextOut(hdc, cx - 18, 100, val, wcslen(val)); 
            }

            // 恢復畫布回到最原始狀態，準備畫下一張牌
            SetWorldTransform(hdc, &xfBase);
        }

        DeleteObject(hFont);
        DeleteObject(hSmall);
        DeleteObject(hBigFont);
        EndPaint(hwnd, &ps);
        break;
    }

    case WM_DESTROY:
        PostQuitMessage(0);
        break;

    default:
        return DefWindowProc(hwnd, msg, wParam, lParam);
    }
    return 0;
}

HMENU CreateAppMenu() {
    HMENU hMenuBar = CreateMenu();

    AppendMenu(hMenuBar, MF_STRING, ID_SINGLE, _T("單人計時賽"));
    AppendMenu(hMenuBar, MF_STRING, ID_DOUBLE, _T("雙人鍵盤競速"));
    AppendMenu(hMenuBar, MF_STRING, ID_MUTIPLE, _T("多人視覺辨識賽"));
    AppendMenu(hMenuBar, MF_STRING, ID_HELP_ABOUT, _T("說明"));
    return hMenuBar;
}

int APIENTRY _tWinMain(HINSTANCE hInstance, HINSTANCE, LPTSTR, int nCmdShow)
{
    const TCHAR CLASS_NAME[] = _T("Win32MenuExample");
    WNDCLASS wc = {};
    wc.lpfnWndProc = WndProc;
    wc.hInstance = hInstance;
    wc.lpszClassName = CLASS_NAME;
    wc.hbrBackground = (HBRUSH)(COLOR_WINDOW + 1);
    wc.hCursor = LoadCursor(NULL, IDC_ARROW);

    if (!RegisterClass(&wc)) {
        MessageBox(NULL, _T("Window Registration Failed!"), _T("Error"), MB_ICONERROR);
        return 0;
    }
    
    // 修改了預設視窗大小，讓 14 排的撲克牌能在一開啟就完美呈現
    HWND hwnd = CreateWindow(CLASS_NAME, _T("心臟病(第17組:1142003 1142023 1142034 1142049 11422055)"), WS_OVERLAPPEDWINDOW, CW_USEDEFAULT, CW_USEDEFAULT, 1300, 600,
        NULL, NULL, hInstance, NULL
    );

    if (!hwnd) {
        MessageBox(NULL, _T("Window Creation Failed!"), _T("Error"), MB_ICONERROR);
        return 0;
    }
    SetMenu(hwnd, CreateAppMenu());
    ShowWindow(hwnd, nCmdShow);
    UpdateWindow(hwnd);
    MSG msg;
    while (GetMessage(&msg, NULL, 0, 0)) {
        TranslateMessage(&msg);
        DispatchMessage(&msg);
    }
    return (int)msg.wParam;
}
